# GrowKaro Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/growkaro?retryWrites=true&w=majority

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Phase 2 — Groq AI Reasoning (Get free key from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Phase 2 — Cognee Merchant Memory (Optional; MongoDB memory store active by default)
COGNEE_API_URL=
COGNEE_API_KEY=

# Phase 3 & 4 — n8n Workflow Orchestration (Optional; Simulation Sandbox active by default)
N8N_MODE=simulation
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=
N8N_API_KEY=
N8N_WEBHOOK_SECRET=growkaro-default-secret